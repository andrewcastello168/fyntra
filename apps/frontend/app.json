{
  "expo": {
    "name": "Fyntra",
    "slug": "fyntra",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#F7F7F3",
    "icon": "./assets/images/icon.png",
    "scheme": "fyntra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.andrew.fyntra",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F3",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Fyntra to use Face ID to unlock your session."
        }
      ],
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#F7F7F3",
          "barStyle": "dark",
          "borderColor": "#E2E8F0",
          "position": "relative",
          "visibility": "visible",
          "behavior": "inset-swipe"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F7F3",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#171A17"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "backgroundColor": "#F7F7F3",
        "barStyle": "dark",
        "borderColor": "#E2E8F0",
        "position": "relative",
        "visibility": "visible",
        "behavior": "inset-swipe"
      },
      "eas": {
        "projectId": "29ba3407-5cb8-4289-92e4-16261023aa4e"
      }
    }
  }
}
